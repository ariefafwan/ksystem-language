{
  "scopeName": "source.ksys",
  "patterns": [
    {
      "match": "\\b(SCREEN|END_SCREEN)\\b",
      "name": "keyword.declaration.ksys"
    },
    {
      "match": "\\b(IMAGE|FIELD|EDITS|LOCAL|PGM_FIELDS|PGM_FIELD|SPCALCS|MAP|CALCS|DBCALCS|HOOKS|PERMIT|POSTING|HELP|SUBFILE|DEFAULT|DEFAULTS|FIELDS|RTREE)\\b",
      "name": "keyword.control.ksys"
    },
    {
      "match": "\\b(MENU_TYPE|QUERY_TYPE|APP_TYPE|REPORT_TYPE)\\b",
      "name": "storage.type.ksys"
    },
    {
      "match": "\\b(NUMERIC|ALLCAPS|PROTECT|DO_SKIP_IF|DFLOAT|DIGITS|DTARGET|DFALT_LIST|TEXTAREA|DFALT_SCAN_BLANK|INIT_ADD|DLTARGET|DBC_COMMAND|DBC_COND|DLLEN|DBC_TARGET|DBC_MAP|DBC_SUM_MAP|DBC_SELECT|NONE|STRING|INT2|MAPMAP|SCANSCAN|DATE|INPUTRI|ADD|UPDATE_RANGE|DELETE|DNAME|DCOMMAND|DMAP|DFILE|NOCHANGE|RI|BIG|BLANKS|MANDATORY|VALIDATE|MANDATORY_IF|REPLACE|DO_CALC|REPLACE_IF|DFALT_SCAN|INIT|DFALT_RADIO_BUTTON|TOMBOL|DUPKEY|UPDATE|DO_MAP|IF|ELSE|SHOW|HKMSG|cur_field|DO_LIB|DO_LIB_IF|cur_keybd|DO_CALC_IF)\\b",
      "name": "constant.language.ksys"
    },
    {
      "match": "\\b(gv_[A-Za-z0-9_]+|gt_[A-Za-z0-9_]+|g_[A-Za-z0-9_]+|ap_[A-Za-z0-9_]+)\\b",
      "name": "variable.language.ksys"
    },
    {
      "match": "\".*?\"",
      "name": "string.quoted.ksys"
    },
    {
      "begin": "/\\*",
      "end": "\\*/",
      "name": "comment.block.ksys"
    },
    {
      "begin": "^[\\\\/|\\-]+",
      "end": "$",
      "name": "string.unquoted.form.ksys"
    },
    {
      "match": "_{2,}",
      "name": "variable.other.field.ksys"
    },
    {
      "match": "^(\\s*(?!(NUMERIC|ALLCAPS|DO_SKIP_IF|PROTECT|DFLOAT|DIGITS|DFALT_LIST|DTARGET|TEXTAREA|DFALT_SCAN_BLANK|INIT_ADD|DLTARGET|DBC_COMMAND|DBC_COND|DLLEN|DBC_TARGET|DBC_MAP|DBC_SUM_MAP|DBC_SELECT|NONE|STRING|INT2|MAPMAP|SCANSCAN|DATE|INPUTRI|ADD|UPDATE_RANGE|DELETE|DNAME|DCOMMAND|DMAP|DFILE|NOCHANGE|RI|BIG|BLANKS|MANDATORY|VALIDATE|MANDATORY_IF|REPLACE|DO_CALC|REPLACE_IF|DFALT_SCAN|INIT|DFALT_RADIO_BUTTON|TOMBOL|DUPKEY|UPDATE|DO_MAP|IF|ELSE|SHOW|HKMSG|cur_field|DO_LIB|DO_LIB_IF|cur_keybd|DO_CALC_IF)\\b)[A-Za-z0-9_]+)",
      "name": "entity.name.function.ksys"
    },
    {
      "match": "\\b([lc][A-Za-z0-9_]*)\\b",
      "name": "entity.name.function.ksys"
    }
  ]
}
