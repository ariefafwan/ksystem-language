{
  "Screen Template": {
    "prefix": "scr",
    "body": [
      "SCREEN ${TM_FILENAME_BASE/(sct)([0-9]+)/$2/} ${1:QUERY_TYPE|APP_TYPE|MENU_TYPE|REPORT_TYPE} ${2:s.ProgramName}",
      "SCR_FILE ${3:name_of_master_file}",
      "SCR_LOGFLD ${4:logfield}",
      "SCR_NXT_POSTING_IF ${5:layarPosting}",
      "SCR_NXT_MSG IF ${6:calccondition} ${7:Message}",
      "            IF ${8:calccondition} ${9:Message}",
      "SCR_NEXT_MAP ${10:mapPosting}",
      "SCR_APR ${11:calcdolib}",
      "SCR_APRFLD ${12:fieldname}",
      "SCR_APR_COND ${13:calccondition}",
      "SCR_APR_MSG IF ${14:calccondition} ${15:Message}",
      "            IF ${16:calccondition} ${17:Message}",
      "    IMAGE(master)",
      "    FIELD(master)",
      "    EDITS(master)",
      "    MAP(mymap)",
      "    CALCS()",
      "    HOOKS(master)",
      "    DBCALCS(master)",
      "    SPCALCS(master)",
      "    POSTING(master)",
      "    PERMIT(master)",
      "END_SCREEN"
    ],
    "description": "Basic screen template (auto number from filename)"
  },

  "Map Block": {
    "prefix": "map",
    "body": [
      "MAP(${1:MapName})",
      "    ${2:FieldORCalcs} ${3:TargetField} ${4:REPLACE|REPLACE_IF|DO_CALC|DO_CALC_IF}"
    ],
    "description": "MAP block with source and target fields"
  },

  "Calc Block": {
    "prefix": "calc",
    "body": [
      "CALCS()",
      "    ${1:CalcName} "
    ],
    "description": "CALCS block"
  },

  "Hook After Input (DO_MAP)": {
    "prefix": "hookmap",
    "body": [
      "AFTER_INPUT cur_field=${1:FieldName} DO_MAP SHOW ${2:MapName}"
    ],
    "description": "HOOKS rule AFTER_INPUT with DO_MAP SHOW"
  },

  "Hook After Input (DO_LIB)": {
    "prefix": "hooklib",
    "body": [
      "AFTER_INPUT cur_field=${1:FieldName} DO_LIB ${2:LibName}(${3:params})"
    ],
    "description": "HOOKS rule AFTER_INPUT with DO_LIB"
  },

  "Hook Before Input (DO_MAP)": {
    "prefix": "bmap",
    "body": [
      "BEFORE_INPUT cur_field=${1:FieldName} DO_MAP SHOW ${2:MapName}"
    ],
    "description": "HOOKS rule BEFORE_INPUT with DO_MAP SHOW"
  },

  "After Input Hooks": {
    "prefix": "after_",
    "body": [
      "AFTER_INPUT cur_field=${1:FieldName} DO_MAP SHOW ${2:MapName}"
    ]
  },

  "Before Input Hooks": {
    "prefix": "before_",
    "body": [
      "BEFORE_INPUT cur_field=${1:FieldName} DO_MAP SHOW ${2:MapName}"
    ]
  },

  "Hook Condition Example": {
    "prefix": "hookif",
    "body": [
      "AFTER_INPUT cur_field=${1:FieldName} DO_MAP SHOW ${2:MapName}",
      "    IF ${3:condition}",
      "    ELSE HKCURSOR STAY",
      "    HKMSG ${4:Message}"
    ],
    "description": "HOOKS example with IF/ELSE and HKMSG"
  },

  "Permit Block": {
    "prefix": "permit",
    "body": [
      "PERMIT(${1:master})",
      "    ${2:PMT_ADD_COND|PMT_UPDALL_COND|PMT_DEL_COND} ${3:CalcName}"
    ],
    "description": "PERMIT block for permissions"
  },

  "ap_dbclc Template": {
    "prefix": "ap_dbclc",
    "body": [
      "DO_LIB ap_dbclc(DNAME ${1:dname}, DCOMMAND ${2:ADD|UPDATE}, DFILE ${4:filename}, DMAP ${5:mapnyaapa);"
    ],
    "description": "ap_dbclc template for spcalcs"
  },

  "Local Vars": {
    "prefix": "local",
    "body": [
      "LOCAL",
      "PGM_FIELDS",
      "    ${1:varname} ${2:STRING|DATE|INT2|DFLOAT} ${3:panjang}"
    ],
    "description": "LOCAL variables declaration"
  },

  "FIELD": {
    "prefix": "field",
    "body": [
      "FIELD(${1:master})",
      "${2:FieldName} ${3:ALLCAPS|PROTECT|DIGITS|NONE} ${4:SCROLL|NONE} ${5:INPUTRI|RI|NONE} ${6:1}"
    ]
  },

  "Default Block": {
    "prefix": "def",
    "body": [
      "DEFAULT(${1:master})",
      "    ${2:FieldName} = ${3:DefaultValue}"
    ],
    "description": "DEFAULT block to set default values"
  },

  "Help Block": {
    "prefix": "help",
    "body": [
      "HELP(${1:master})",
      "    \"${1:Help text for this field}\" ${2:FieldName}"
    ],
    "description": "HELP block"
  },

  "Form Template": {
    "prefix": "form",
    "body": [
      "IMAGE(${1:master})",
      "/------------------------------------\\",
      "|| ${2:t.Field1}   :________________ ||",
      "|| ${3:t.Field2}   :________________ ||",
      "|| ${4:t.Field3}   :________________ ||",
      "|| ${5:t.Field4}   :________________ ||",
      "\\------------------------------------/"
    ],
    "description": "Template for IMAGE + ASCII form fields"
  },

  "Field Row": {
    "prefix": "fld",
    "body": [
      "|| ${1:t.Field}   :________________ ||"
    ],
    "description": "Single row field inside IMAGE form"
  },

  "SPCALCS Block": {
    "prefix": "spcalc",
    "body": [
      "SPCALCS(${1:SpcalcName})",
      "    ${1:dbcalcname|IF|DO_LIB|DO_LIB_IF}"
    ],
    "description": "SPCALCS block"
  },

  "DBCALCS Block": {
    "prefix": "dbcalc",
    "body": [
      "DBCALCS(${1:DbcalcName})",
      "    DBC_COMMAND ${2:ADD|UPDATE|DELETE|JOIN|JOIN_LAST_SFL}",
      "    DBC_COND ${3:calccondition}",
      "    DBC_FILE ${4:LibName}",
      "    DBC_Target ${5:indexjoin}",
      "    DBC_MAP ${6:mapname}"
    ],
    "description": "DBCALCS block"
  },

  "SCR_UPL Block": {
    "prefix": "scrupl",
    "body": [
      "SCR_UPLFLD   ${1:fieldname}",
      "SCR_UPLFLD2  ${2:fieldname2}",
      "SCR_UPL_DIRFLD  ${3:dirfieldname}",
      "SCR_UPLFLD_DBCALCS  ${4:DbcalcName}",
      "SCR_UPL_DELCOND ${5:calccondition}"
    ],
    "description": "SCR_UPL block"
  },

  "POSTING Block": {
    "prefix": "post",
    "body": [
      "POSTING(${1:master|trans})",
      "    ${2:PST_ADDCMD|PST_UPDCMD|PST_DELCMD|PST_UPD_DET_COND|PST_SUB_ADDCMD} ${3:SpcalcName}"
    ],
    "description": "POSTING block"
  },

  "SUBFILE Block": {
    "prefix": "sub",
    "body": [
      "SUBFILE(${1:transt})",
      "    SF_LINES ${2:10|20|30}",
      "    SFL_TITLE ${2:transt}",
      "    SFL_COND ${3:calccondition}",
      "    SFL_SORT_BY_FIELD ${3:sortfield}",
      "    SFL_TRANS2_FIELD ${4:trans2field}",
      "    SFL_MAP",
      "        ${5:calcOrField} ${6:TargetField}",
      "        ${7:calcOrField} ${8:TargetField}",
      "        ${9:calcOrField} ${10:TargetField}",
      "        ${11:calcOrField} ${12:TargetField}",
      "    SFL_TEMPLATE ${5:template}"
    ],
    "description": "SUBFILE block"
  },

  "RTREE Block": {
    "prefix": "rtree",
    "body": [
      "RTREE(${1:report})",
      "    RT_COND ${2:calccondition}",
      "    USES_SCRIPT ${2:LaporanName}",
      "    RT_NXT_POSTING ${3:layarPosting}",
      "    RT_NXT_MAP ${4:layarMap}",
      "    RT_MAP ${5:layarHooks}",
      "    RT_PRINT_BACKUP",
      "    RT_XLSX"
    ],
    "description": "RTREE block for laporan"
  },

  "Block Comment": {
    "prefix": "cmt",
    "body": [
      "/* ${1:komentar} */"
    ],
    "description": "Insert a block comment"
  }
}
