{
  "Screen Template": {
    "prefix": "scr",
    "body": [
      "SCREEN ${TM_FILENAME_BASE/(sct)([0-9]+)/$2/} ${1:QUERY_TYPE|APP_TYPE|MENU_TYPE|REPORT_TYPE} ${2:s.ProgramName}",
      "SCR_FILE ${3:name_of_master_file}",
      "SCR_LOGFLD ${4:logfield}",

      "IMAGE(master)",
      "FIELD(master)",
      "DEFAULT(master)",
      "EDITS(master)",
      "MAP(mymap)",
      "CALCS()",
      "HOOKS(master)",
      "DBCALCS(master)",
      "SPCALCS(master)",
      "POSTING(master)",
      "PERMIT(master)",

      "END_SCREEN"
    ],
    "description": "Basic screen template (auto number from filename)"
  },

  "SCR APPROVAL": {
    "prefix":"scr_apr",
    "body": [
      "SCR_APR ${1:calcdolib}",
      "SCR_APRFLD ${2:fieldname}",
      "SCR_APR_COND ${3:calccondition}",
      "SCR_APR_MSG IF ${4:calccondition} ${5:Message}",
      "            IF ${6:calccondition} ${7:Message}"
    ]
  },

  "SCR NXT_POST": {
    "prefix":"scr_nxt",
    "body": [
      "SCR_NXT_POSTING_IF ${1:layarPosting}",
      "SCR_NXT_MSG IF ${2:calccondition} ${3:Message}",
      "            IF ${4:calccondition} ${5:Message}",
      "SCR_NEXT_MAP ${6:mapPosting}"
    ]
  },

  "Map Block": {
    "prefix": "map",
    "body": [
      "MAP(${1:MapName})",
      "${2:FieldORCalcs}       ${3:TargetField}        ${4:REPLACE}"
    ],
    "description": "MAP block with source and target fields"
  },

  "Calc Block": {
    "prefix": "calc",
    "body": [
      "CALCS()",
      "${1:CalcName}"
    ],
    "description": "CALCS block"
  },

  "Hook After Input (DO_MAP)": {
    "prefix": "hookmap",
    "body": [
      "AFTER_INPUT cur_field=${1:FieldName} DO_MAP SHOW ${2:MapName}"
    ],
    "description": "HOOKS rule AFTER_INPUT with DO_MAP SHOW"
  },

  "Hook After Input (DO_LIB)": {
    "prefix": "hooklib",
    "body": [
      "AFTER_INPUT cur_field=${1:FieldName} DO_LIB ${2:LibName}(${3:params})"
    ],
    "description": "HOOKS rule AFTER_INPUT with DO_LIB"
  },

  "Hook Before Input (DO_MAP)": {
    "prefix": "bmap",
    "body": [
      "BEFORE_INPUT cur_field=${1:FieldName} DO_MAP SHOW ${2:MapName}"
    ],
    "description": "HOOKS rule BEFORE_INPUT with DO_MAP SHOW"
  },

  "After Input Hooks": {
    "prefix": "after_",
    "body": [
      "AFTER_INPUT cur_field=${1:FieldName} DO_MAP SHOW ${2:MapName}"
    ]
  },

  "Before Input Hooks": {
    "prefix": "before_",
    "body": [
      "BEFORE_INPUT cur_field=${1:FieldName} DO_MAP SHOW ${2:MapName}"
    ]
  },

  "Hook Condition Example": {
    "prefix": "hookif",
    "body": [
      "AFTER_INPUT cur_field=${1:FieldName} DO_MAP SHOW ${2:MapName}",
      "    IF ${3:condition}",
      "    ELSE HKCURSOR STAY",
      "    HKMSG ${4:Message}"
    ],
    "description": "HOOKS example with IF/ELSE and HKMSG"
  },

  "Permit Block": {
    "prefix": "permit",
    "body": [
      "PERMIT(${1:master})",
      "    ${2:PMT_ADD_COND} ${3:CalcName}"
    ],
    "description": "PERMIT block for permissions"
  },

  "ap_dbclc UPDATE Template": {
    "prefix": "upd",
    "body": [
      "DO_LIB   ap_dbclc(DNAME ${1:dname}, DCOMMAND ${2:UPDATE}, DTARGET ${3:indexname}, DMAP ${4:mapnyaapa});"
    ],
    "description": "ap_dbclc upd template for spcalcs"
  },

  "ap_dbclc ADD Template": {
    "prefix": "add",
    "body": [
      "DO_LIB   ap_dbclc(DNAME ${1:dname}, DCOMMAND ${2:ADD}, DFILE ${3:namafile}, DMAP ${4:mapnyaapa});"
    ],
    "description": "ap_dbclc add template for spcalcs"
  },

  "ap_dbclc MAPMAP Template": {
    "prefix": "mapmap",
    "body": [
      "DO_LIB   ap_dbclc(DNAME ${1:dname}, DCOMMAND ${2:MAPMAP}, DMAP ${3:mapnyaapa});"
    ],
    "description": "ap_dbclc mapmap template for spcalcs"
  },

  "ap_dbclc SCANSCAN Template": {
    "prefix": "scanscan",
    "body": [
      "DO_LIB   ap_dbclc(DNAME ${1:dname}, DCOMMAND ${2:SCANSCAN}, DTARGET ${3:indexname}, DLTARGET ${4:indexname}, DBC_SUM_MAP ${5:mapnyaapa});"
    ],
    "description": "ap_dbclc scanscan template for spcalcs"
  },

  "ap_nxpst Template": {
    "prefix": "ap_nxpst",
    "body": [
      "DO_LIB   ap_nxpst(${1:lscr}, ${2:lmapposting})"
    ]
  },

  "Local Vars": {
    "prefix": "local",
    "body": [
      "LOCAL",
      "PGM_FIELDS",
      "${1:varname}     ${2:STRING}     ${3:panjang}"
    ],
    "description": "LOCAL variables declaration"
  },

  "Local 1 vars": {
    "prefix": "lvar",
    "body": [
      "${1:varname}     ${2:STRING}     ${3:21}"
    ]
  },

  "FIELD": {
    "prefix": "field",
    "body": [
      "FIELD(${1:master})",
      "${2:FieldName}   ${3:INPUTRI}    ${5:1}"
    ]
  },

  "Default Block": {
    "prefix": "def",
    "body": [
      "DEFAULT(${1:master})",
      "${2:FieldName}           INIT            ${3:DefaultValue}"
    ],
    "description": "DEFAULT block to set default values"
  },

  "Help Block": {
    "prefix": "help",
    "body": [
      "HELP(${1:master})",
      "         \"${1:Help text for this field}\" ${2:FieldName}"
    ],
    "description": "HELP block"
  },

  "Form Template": {
    "prefix": "form",
    "body": [
      "IMAGE(${1:master})",
      "/------------------------------------\\",
      "|| ${2:t.Field1}   :________________ ||",
      "|| ${3:t.Field2}   :________________ ||",
      "|| ${4:t.Field3}   :________________ ||",
      "|| ${5:t.Field4}   :________________ ||",
      "\\------------------------------------/"
    ],
    "description": "Template for IMAGE + ASCII form fields"
  },

  "Field Row": {
    "prefix": "fld",
    "body": [
      "|| ${1:t.Field}   :________________ ||"
    ],
    "description": "Single row field inside IMAGE form"
  },

  "SPCALCS Block": {
    "prefix": "spcalc",
    "body": [
      "SPCALCS(${1:SpcalcName})",
      "         ${2:dbcalcname}"
    ],
    "description": "SPCALCS block"
  },

  "DBCALCS Block": {
    "prefix": "dbcalc",
    "body": [
      "DBCALCS(${1:DbcalcName})",
      "        DBC_COMMAND ${2:JOIN}",
      "        DBC_COND ${3:calccondition}",
      "        DBC_TARGET ${5:indexjoin}",
      "        DBC_MAP ${6:mapname}"
    ],
    "description": "DBCALCS block"
  },

  "SCR_UPL Block": {
    "prefix": "scrupl",
    "body": [
      "SCR_UPLFLD   ${1:fieldname}",
      "SCR_UPLFLD2  ${2:fieldname2}",
      "SCR_UPL_DIRFLD  ${3:dirfieldname}",
      "SCR_UPLFLD_DBCALCS  ${4:DbcalcName}",
      "SCR_UPL_DELCOND ${5:calccondition}"
    ],
    "description": "SCR_UPL block"
  },

  "POSTING Block": {
    "prefix": "post",
    "body": [
      "POSTING(${1:master|trans})",
      "         ${2:PST_COMMAND} ${3:SpcalcName}",
      "         ${8:PST_COND} ${9:calcond}"
    ],
    "description": "POSTING block"
  },

  "SUBFILE Block": {
    "prefix": "sub",
    "body": [
      "SUBFILE(${1:transt})",
      "SFL_LINES(${2:5})",
      "SFL_COND ${4:calccondition}",
      "SFL_SELECT ${5:calcselect}",
      "SFL_TARGET ${6:namaindex}",
      "SFL_SORT_BY_FIELD ${5:sortfield}",
      "SFL_TRANS2_FIELD ${6:trans2field}",
      "SFL_TEMPLATE ${7:template}"
    ],
    "description": "SUBFILE block"
  },

  "RTREE Block": {
    "prefix": "rtree",
    "body": [
      "RTREE(${1:report})",
      "RT_COND ${2:calccondition}",
      "USES_SCRIPT ${2:LaporanName}",
      "RT_NXT_POSTING ${3:layarPosting}",
      "RT_NXT_MAP ${4:layarMap}",
      "RT_MAP ${5:mparam}",
      "RT_PRINT_BACKUP",
      "${6:RT_XLSX|RT_HTML|RT_PDF}"
    ],
    "description": "RTREE block for laporan"
  },

  "Trans": {
	"prefix": "trans",
	"body": [
		"IMAGE(${1:trans})",
		"|_______________|",
		"",
		"FIELD(${1:trans})",
		"fieldname      NOCHANGE         1",
		"",
		"CALCS()",
      		"${2:calccondition}",
		"",
		"SUBFILE(${1:trans})",
		"SFL_LINES(${2:5})",
		"SFL_COND ${4:calccondition}",
		"SFL_SELECT ${5:calcselect}",
		"SFL_TARGET ${6:namaindex}"
	]
  },

  "Block Comment": {
    "prefix": "cmt",
    "body": [
      "/* ${1:komentar} */"
    ],
    "description": "Insert a block comment"
  }
}
