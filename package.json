{
  "name": "ksystem-language",
  "displayName": "K-System Language",
  "description": "Syntax highlighting, snippets, and formatting for K-System programs",
  "version": "1.1.4",
  "publisher": "teukuafwan",
  "engines": {
    "vscode": "^1.103.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:ksystem"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ksystem",
        "aliases": [
          "K-System",
          "ksys"
        ],
        "filenames": [],
        "extensions": [],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ksystem",
        "scopeName": "source.ksys",
        "path": "./syntaxes/ksystem.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "ksystem",
        "path": "./snippets/ksystem.code-snippets.json"
      }
    ],
    "formatters": [
      {
        "language": "ksystem"
      }
    ],
    "configurationDefaults": {
      "[ksystem]": {
        "editor.insertSpaces": false,
        "editor.tabSize": 8
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "prettier": "^3.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.11",
    "@types/vscode": "^1.103.0",
    "typescript": "^5.9.2"
  }
}
